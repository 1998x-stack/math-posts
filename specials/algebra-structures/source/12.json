      "aria": "整数合数命题的表达式",
      "xml": "<mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><mn>4</mn></mrow></mrow>"
    }
  },
  "motivation": "看到四次式加四，可以把四看作两个 y 平方项的平方：通过补入中间项，构成完全平方再拆解。",
  "steps": [
    {
      "title": "配出一个完全平方",
      "goal": "写出 (x²+2y²)²，比较它与原式的差。",
      "reason": "完全平方展开会多出 4x²y²，恰好是 (2xy)²。",
      "eq": {
        "aria": "完全平方展开式",
        "xml": "<mrow><mrow><msup><mrow><mrow><mo>(</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>)</mo></mrow></mrow><mrow><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow></mrow>"
      },
      "check": "补出的交叉项系数是四，不是二。"
    },
    {
      "title": "用平方差拆成两个二次因子",
      "goal": "减去 (2xy)² 后应用平方差公式。",
      "reason": "一般恒等式 A²−B²=(A−B)(A+B) 对任意交换环成立。",
      "eq": {
        "aria": "平方差分解结果",
        "xml": "<mrow><mrow><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><mn>4</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>4</mn></mrow></msup></mrow><mo>=</mo><mrow><mo>(</mo><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>−</mo><mn>2</mn><mi>x</mi><mi>y</mi><mo>+</mo><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>)</mo></mrow><mrow><mo>(</mo><mrow><msup><mrow><mi>x</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>x</mi><mi>y</mi><mo>+</mo><mn>2</mn><msup><mrow><mi>y</mi></mrow><mrow><mn>2</mn></mrow></msup></mrow><mo>)</mo></mrow></mrow></mrow>"
      },
      "check": "将两个因子反向展开，应恢复四次幂与四倍四次幂。"
    },
    {
      "title": "特化为整数 n",
      "goal": "令 x=n、y=1，得到两个整数因子。",
      "reason": "整数代入后两个二次式仍为整数。",
      "eq": {
        "aria": "整数代入后的两个因子",
        "xml": "<mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>4</mn></mrow></msup><mo>+</mo><mn>4</mn><mo>=</mo><mrow><mo>(</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>−</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>2</mn><mo>)</mo></mrow><mrow><mo>(</mo><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>2</mn><mo>)</mo></mrow></mrow></mrow>"
      },
      "check": "题目范围是 n>1；n=1 时第一个因子为一，不能由此证明合数。"
    },
    {
      "title": "分别证明两个因子大于一",
      "goal": "把较小因子再次配方。",
      "reason": "n²−2n+2=(n−1)²+1，对 n≥2 最小为 2；另一因子显然更大。",
      "eq": {
        "aria": "较小因子等于一个平方加一",
        "xml": "<mrow><mrow><msup><mrow><mi>n</mi></mrow><mrow><mn>2</mn></mrow></msup><mo>−</mo><mn>2</mn><mi>n</mi><mo>+</mo><mn>2</mn><mo>=</mo><msup><mrow><mrow><mo>(</mo><mi>n</mi><mo>−</mo><mn>1</mn><mo>)</mo></mrow></mrow><mrow><mn>2</mn></mrow></msup><mo>+</mo><mn>1</mn><mo>≥</mo><mn>2</mn></mrow></mrow>"
      },
      "check": "两个因子都为正整数且严格大于一，才构成合数证明。"
    }
